# =============================================================================
# AIPRESENTATION SAAS — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Only .env.example is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
APP_DOMAIN=localhost              # app.unslid.com in production
API_DOMAIN=localhost              # api.unslid.com in production (if separate)
CAN_CHANGE_KEYS=false             # false = admin/env managed API keys

# -----------------------------------------------------------------------------
# SUPABASE (Auth + Database)
# Get these from: https://supabase.com → your project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://hlkawpxepygxxwjsxlgt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Settings → API → anon public key
SUPABASE_SERVICE_ROLE_KEY=             # Settings → API → service_role secret key
SUPABASE_JWT_SECRET=                   # Settings → API → JWT secret

# Database connection string
# Settings → Database → Connection string → URI tab
# Replace [YOUR-PASSWORD] with your Supabase database password
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hlkawpxepygxxwjsxlgt.supabase.co:5432/aipresentation

# -----------------------------------------------------------------------------
# WASABI S3 STORAGE
# Get these from: https://wasabi.com → Access Keys
# -----------------------------------------------------------------------------
WASABI_ACCESS_KEY_ID=              # Your Wasabi access key ID
WASABI_SECRET_ACCESS_KEY=          # Your Wasabi secret access key
WASABI_ENDPOINT_URL=https://s3.eu-central-1.wasabisys.com

# Bucket names per region (dev uses a single bucket, production uses one per region)
WASABI_BUCKET_DEV=aipresentation   # Used in development mode
WASABI_BUCKET_US=                  # Production: US bucket (us-east-1)
WASABI_BUCKET_EU=aipresentation    # Production: EU bucket (eu-central-1) — GDPR required
WASABI_BUCKET_AP_SE=               # Production: Asia Pacific SE bucket
WASABI_BUCKET_AP_NE=               # Production: Asia Pacific NE bucket

# -----------------------------------------------------------------------------
# AI PROVIDER (at least one required for presentation generation)
# Leave blank if not yet configured — app will prompt to set up
# -----------------------------------------------------------------------------
LLM=                               # openai | google | anthropic | ollama | custom
IMAGE_PROVIDER=                    # dall-e-3 | gemini_flash | pexels | pixabay

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=models/gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Pexels (free image provider — recommended as default)
PEXELS_API_KEY=

# -----------------------------------------------------------------------------
# NEXT.JS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000   # Points to FastAPI (local dev)

# -----------------------------------------------------------------------------
# IFRAME / CRM VALIDATION
# -----------------------------------------------------------------------------
# Iframe URL format:
# https://BASE_DOMAIN/CUSTOMER_DOMAIN?apiKey=ZETTABLE_API_KEY&customerApiKey=CUSTOMER_API_KEY
IFRAME_CRM_BASE_URL=https://zettable.com
IFRAME_CRM_VALIDATE_URL=          # Optional legacy POST validation endpoint
IFRAME_CRM_AUTH_TOKEN=            # Optional Bearer token for CRM validation
IFRAME_CRM_API_KEY=               # Optional X-API-Key for CRM validation
IFRAME_FRAME_ANCESTORS=           # Optional CSP value, e.g. https://crm.example.com https://*.client.com

# -----------------------------------------------------------------------------
# STRIPE (Billing — add when implementing billing phase)
# -----------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Email: configure Mailgun via Admin → Email Settings (API key stored encrypted in DB)

# -----------------------------------------------------------------------------
# SENTRY (Error monitoring — add before going to production)
# -----------------------------------------------------------------------------
SENTRY_DSN_FASTAPI=
SENTRY_DSN_NEXTJS=

# -----------------------------------------------------------------------------
# REDIS (auto-configured via Docker Compose — do not change for local dev)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
