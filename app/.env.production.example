# ============================================================
#  PRODUCTION environment variables
#  Copy this file to .env on the server and fill in every value.
#  NEVER commit the real .env file.
# ============================================================

# Domains
APP_DOMAIN=app.unslid.com
NEXT_PUBLIC_LEGAL_DOMAIN=https://unslid.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=aipresentation
MYSQL_USER=presenton
MYSQL_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# App secret
# Used for JWT signing and field-level encryption key derivation.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=168

# Wasabi S3 storage
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_ENDPOINT_URL=https://s3.eu-central-1.wasabisys.com
WASABI_BUCKET_EU=
WASABI_BUCKET_US=
WASABI_BUCKET_DEV=
WASABI_BUCKET_AP_SE=
WASABI_BUCKET_AP_NE=

# Stripe billing
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...

# Email
RESEND_API_KEY=re_...
EMAIL_FROM=Unslid <hello@unslid.com>

# Error monitoring
SENTRY_DSN_FASTAPI=
SENTRY_DSN_NEXTJS=

# AI defaults
LLM=openai
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
IMAGE_PROVIDER=pexels

# Backups
BACKUP_RETAIN_DAYS=14
