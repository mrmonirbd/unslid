# ============================================================
#  PRODUCTION environment variables — Linode VPS
#  Copy this to .env on the server and fill in all values.
#  NEVER commit the actual .env file to git.
# ============================================================

# ─── Domains ──────────────────────────────────────────────────────────────────
# SaaS app subdomain (e.g. app.unslid.com)
APP_DOMAIN=app.unslid.com

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Generate a strong password: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=aipresentation

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── App Secret ───────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_HEX_64_CHARS

# ─── Wasabi S3 Storage ────────────────────────────────────────────────────────
WASABI_ACCESS_KEY_ID=your-access-key
WASABI_SECRET_ACCESS_KEY=your-secret-key
WASABI_ENDPOINT_URL=https://s3.eu-central-1.wasabisys.com
WASABI_BUCKET_EU=your-eu-bucket
WASABI_BUCKET_US=your-us-bucket
WASABI_BUCKET_DEV=your-dev-bucket
WASABI_BUCKET_AP_SE=
WASABI_BUCKET_AP_NE=

# ─── Stripe Billing ───────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Email (Mailgun) — configure via Admin panel after deploy (API key stored encrypted in DB)

# ─── Sentry (error monitoring) ────────────────────────────────────────────────
SENTRY_DSN_FASTAPI=https://...@sentry.io/...
SENTRY_DSN_NEXTJS=https://...@sentry.io/...

# ─── AI Models (defaults — override per plan in Admin Panel) ──────────────────
LLM=openai
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
IMAGE_PROVIDER=pexels

# ─── Legal Pages ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_LEGAL_DOMAIN=https://yourdomain.com

# ─── Google Analytics 4 (optional) ────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Backups ──────────────────────────────────────────────────────────────────
BACKUP_RETAIN_DAYS=14


NEXT_PUBLIC_SUPABASE_URL=https://tzvsdzettvkugcekgfgw.supabase.co
